# ─── MongoDB ─────────────────────────────────────────────────────────────────
# MongoDB connection URI (Atlas or local)
MONGO_URI=mongodb://localhost:27017/csit_mentor_diary

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# ─── Admin & Mentor Registration Keys ─────────────────────────────────────────
# Keys used to guard admin/mentor registration
ADMIN_REGISTRATION_KEY=your_admin_registration_key_here
MENTOR_REGISTRATION_KEY=your_mentor_registration_key_here

# ─── Seed Administrator Credentials (Optional) ───────────────────────────────
# Used by npm run seed to bootstrap the first administrator
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@csit.edu.in
ADMIN_PASSWORD=Admin@2024

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000
